<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Primary">
   <children>
       <HBox spacing="15">
           <Label text="Ingrese un número"/>
           <TextField fx:id="fldInput"/>
           <Button text="Analizar" onAction="#actionAnalize"/>
           <Button text="Limpiar" onAction="#actionClear"/>
       </HBox>
        <HBox spacing="40">
            <Label fx:id="lblStatsNames" />
            <Label fx:id="lblStatsValues"/>
            <Label fx:id="lblDivisors"/>
        </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
