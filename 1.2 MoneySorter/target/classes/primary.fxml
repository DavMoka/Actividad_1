<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Primary">
   <children>
       <HBox spacing="20" alignment="CENTER">
           <Label text="Dinero:" alignment="CENTER_LEFT"/>
           <TextField fx:id="fldInput" alignment="CENTER"/>
           <Button text="X" onAction="#actionClear" alignment="CENTER"/>
           <Button text="Desplegar" fx:id="btnDisplay" onAction="#actionDisplay" alignment="CENTER_LEFT"/>
       </HBox>
       <HBox spacing="50" alignment="CENTER">
           <Label fx:id="lblTypes" alignment="CENTER_LEFT"/>
           <Label fx:id="lblResult" alignment="CENTER_RIGHT"/>
       </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
